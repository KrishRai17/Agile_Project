# Copy this file to .env.local and fill in real values. Never commit .env.local.

# REQUIRED in production: secret used to sign login sessions (16+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In development a built-in fallback is used, so you can leave this unset locally.
SESSION_SECRET=

# Optional: password for the demo accounts (student@hopon.demo, driver@hopon.demo).
# Defaults to the value documented in the README. Change it for any shared deployment.
# HOPON_DEMO_PASSWORD=

# Optional: save offers and requests to this JSON file so they survive server restarts.
# Works for a single server only; use a real database for serverless or multiple instances.
# HOPON_PERSIST_FILE=.data/hopon-store.json
