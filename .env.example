# Copy this file to .env.local and fill in real values. Never commit .env.local.

# REQUIRED in production: secret used to sign login sessions (16+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In development a built-in fallback is used, so you can leave this unset locally.
SESSION_SECRET=

# Optional: path to the SQLite database file (defaults to .data/hopon.sqlite, or :memory: in tests).
# HOPON_DB_FILE=.data/hopon.sqlite

# Optional: password for the demo accounts (student@hopon.demo, driver@hopon.demo).
# Defaults to the value documented in the README. Change it for any shared deployment.
# HOPON_DEMO_PASSWORD=

# Optional: enable demo accounts and seed offers in production (disabled by default in production).
# HOPON_ENABLE_DEMO=false

# Optional: allow simulated wallet top-ups in non-production environments (never enabled in production).
# HOPON_ALLOW_DEMO_TOPUP=false

# Optional: 16+ character secret used by campus cashiers / administrators to confirm cash wallet top-ups.
# HOPON_CASHIER_SECRET=

# Optional: comma-separated list of university email domains allowed to register (must be confirmed real KJU domains).
# In production, hopon.demo is automatically excluded unless HOPON_ENABLE_DEMO=true.
# ALLOWED_EMAIL_DOMAINS=kristujayanti.com,kju.edu,kju.ac.in

# Optional: set to "true" only when running behind a reverse proxy you control (e.g. nginx, Traefik, Cloudflare)
# so rate limiting trusts X-Forwarded-For / X-Real-IP headers.
# TRUST_PROXY=false

# Optional: number of trusted reverse proxy hops between client and HopOn (defaults to 1).
# When TRUST_PROXY=true, the client IP is selected as the (length - hops) entry in X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1

# Deployment Note:
# HopOn is optimized for single-instance VM or container deployment with persistent disk storage (Docker, Fly.io, Railway, VPS).
# When deploying to production, mount a persistent volume at HOPON_DB_FILE directory (.data/).

# Production Email Delivery (Issue 1):
# For sending university email verification links (/verify?token=...):
# RESEND_API_KEY=
# EMAIL_FROM="HopOn Campus <verify@kristujayanti.com>"
# APP_URL=https://hopon.kristujayanti.edu
# Or outbound webhook delivery:
# EMAIL_WEBHOOK_URL=

# On-Campus Manual Verification / Admin Fallback:
# HOPON_CASHIER_SECRET (16+ chars, defined above) is required for POST /api/cashier/verify-student
# ADMIN_SECRET=

# Optional: comma-separated extra dev origins (LAN IPs / hostnames) allowed by Next.js dev server.
# ALLOWED_DEV_ORIGINS=

# Legacy option: save offers and requests to a JSON snapshot file alongside SQLite.
# SQLite (HOPON_DB_FILE) is the primary store; HOPON_PERSIST_FILE is retained only for legacy compatibility.
# HOPON_PERSIST_FILE=.data/hopon-store.json
